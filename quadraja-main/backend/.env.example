# Banco (SQLite para dev local — sem Docker/credenciais)
DATABASE_URL="file:./dev.db"

# Servidor
PORT=3333
# Defina NODE_ENV=production ao subir em produção: ativa validações extras
# (ex: exige um JWT_SECRET forte) e desliga comportamentos de desenvolvimento.
NODE_ENV=development
# "true" se o backend rodar atras de proxy/load balancer (Render, Railway,
# Nginx, etc.) — necessario para o rate limit identificar o IP real do cliente.
TRUST_PROXY=false

# Auth
# EM PRODUCAO: gere um valor aleatorio forte (>=32 caracteres), nunca use o
# valor de exemplo abaixo. Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# WhatsApp do gestor (somente numeros, com DDI+DDD). Ex: 5511999998888
GESTOR_WHATSAPP="5511999998888"

# Origem(ns) permitida(s) no CORS, separadas por virgula (sem espaco extra).
# Em producao, liste exatamente o(s) dominio(s) do frontend publicado.
CORS_ORIGIN="http://localhost:5173"
