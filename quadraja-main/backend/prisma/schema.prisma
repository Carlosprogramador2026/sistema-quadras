// Schema do sistema de agendamento de quadra de futebol.
// Provider: SQLite para desenvolvimento local (sem Docker/credenciais).
// Para migrar para PostgreSQL depois: troque o provider para "postgresql",
// ajuste a DATABASE_URL e rode `prisma migrate dev`.
//
// Observacao: SQLite nao suporta enum nativo. O campo `status` da Reserva
// e uma String validada no backend (Zod) com os valores:
// PENDENTE | CONFIRMADA | CANCELADA | EM_ESPERA.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Gestor {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  whatsapp  String
  createdAt DateTime @default(now())
}

model Cliente {
  id          Int           @id @default(autoincrement())
  nome        String
  telefone    String
  email       String        @unique
  senha       String
  createdAt   DateTime      @default(now())
  reservas    Reserva[]
  listaEspera ListaEspera[]
  reservasRecorrentes ReservaRecorrente[]
}

model Quadra {
  id          Int           @id @default(autoincrement())
  nome        String
  ativa       Boolean       @default(true)
  valorHora   Float         @default(0)
  createdAt   DateTime      @default(now())
  reservas    Reserva[]
  listaEspera ListaEspera[]
  reservasRecorrentes ReservaRecorrente[]
}

model Reserva {
  id         Int      @id @default(autoincrement())
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  clienteId  Int
  quadra     Quadra   @relation(fields: [quadraId], references: [id])
  quadraId   Int
  data       String // "YYYY-MM-DD"
  horaInicio String // "HH:mm"
  horaFim    String // "HH:mm"
  status     String   @default("PENDENTE")
  valor      Float    @default(0) // snapshot de quadra.valorHora (pos-desconto) no momento da criacao
  createdAt  DateTime @default(now())

  participantes Participante[]

  cupom   Cupom? @relation(fields: [cupomId], references: [id])
  cupomId Int?

  reservaRecorrente   ReservaRecorrente? @relation(fields: [reservaRecorrenteId], references: [id])
  reservaRecorrenteId Int?

  @@index([quadraId, data])
  @@index([status])
  @@index([clienteId])
  @@index([reservaRecorrenteId])
}

model ListaEspera {
  id         Int      @id @default(autoincrement())
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  clienteId  Int
  quadra     Quadra   @relation(fields: [quadraId], references: [id])
  quadraId   Int
  data       String // "YYYY-MM-DD"
  horaInicio String // "HH:mm"
  horaFim    String // "HH:mm"
  posicao    Int
  notificado Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([quadraId, data, horaInicio])
  @@index([clienteId])
}

// Participante de uma reserva (lista de presenca + rateio + sorteio de times).
// Entrada simples (nome/telefone) gerida pelo dono da reserva, nao e conta de usuario.
model Participante {
  id         Int      @id @default(autoincrement())
  reserva    Reserva  @relation(fields: [reservaId], references: [id])
  reservaId  Int
  nome       String
  telefone   String?
  confirmado Boolean  @default(false)
  pago       Boolean  @default(false)
  time       Int? // 1 ou 2 apos o sorteio; null antes de sortear
  createdAt  DateTime @default(now())

  @@index([reservaId])
}

// Cupom de desconto aplicavel na criacao de uma reserva avulsa.
// SQLite nao tem enum nativo: `tipo` e String validada no backend (PERCENTUAL | FIXO).
model Cupom {
  id          Int       @id @default(autoincrement())
  codigo      String    @unique
  tipo        String
  valor       Float
  ativo       Boolean   @default(true)
  validoAte   String? // "YYYY-MM-DD"
  usosMaximos Int?
  usosCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  reservas    Reserva[]
}

// Reserva recorrente (mensalista): fixa o mesmo horario toda semana.
// Materializa reservas reais (Reserva.reservaRecorrenteId) em vez de gerar sob demanda,
// ja que o projeto nao tem infraestrutura de cron/scheduler.
model ReservaRecorrente {
  id         Int      @id @default(autoincrement())
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  clienteId  Int
  quadra     Quadra   @relation(fields: [quadraId], references: [id])
  quadraId   Int
  diaSemana  Int // 0=domingo ... 6=sabado (convencao dayjs().day())
  horaInicio String
  horaFim    String
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  reservas   Reserva[]

  @@index([clienteId])
  @@index([quadraId])
}
